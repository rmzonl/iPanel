# ZN Framework — otomatik oluşturulan dosyalar
web/map.php

# ZN Storage — çalışma zamanı içerikleri (dizinler .gitkeep ile takip edilir)
web/iApp/Storage/Cache/*
web/iApp/Storage/Logs/*
web/iApp/Storage/Session/*
web/iApp/Storage/Crontab/*
web/iApp/Storage/DatabaseBackup/*
!web/iApp/Storage/Cache/.gitkeep
!web/iApp/Storage/Logs/.gitkeep
!web/iApp/Storage/Session/.gitkeep
!web/iApp/Storage/Crontab/.gitkeep
!web/iApp/Storage/DatabaseBackup/.gitkeep

# Yüklenen dosyalar
web/Uploads/*
!web/Uploads/.gitignore
