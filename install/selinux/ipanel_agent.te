module ipanel_agent 1.0;

########################################
# iPanel Agent Unix Socket — SELinux Policy
#
# PHP-FPM (httpd_t domain) iPanel agent Unix socket'e
# (/run/ipanel/agent.sock, tip: httpd_var_run_t) bağlanabilsin.
#
# RHEL/AlmaLinux 9 varsayılan politikası httpd_t'ye
# httpd_var_run_t:sock_file üzerinde connectto izni vermez.
# Bu modül eksikliği tamamlar.
#
# Derleme:
#   checkmodule -M -m -o ipanel_agent.mod ipanel_agent.te
#   semodule_package -o ipanel_agent.pp -m ipanel_agent.mod
#   semodule -i ipanel_agent.pp
########################################

require {
    type httpd_t;
    type httpd_var_run_t;
    class sock_file { read write connectto };
}

#============= httpd_t ==============
allow httpd_t httpd_var_run_t:sock_file { read write connectto };
