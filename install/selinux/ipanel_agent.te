module ipanel_agent 1.0;

########################################
# iPanel Agent Unix Socket — SELinux Policy
#
# PHP-FPM (httpd_t) iPanel agent Unix socket'e
# (/run/ipanel/agent.sock, tip: httpd_var_run_t) bağlanabilsin.
#
# Not: connectto sock_file sınıfında geçerli değil; unix_stream_socket
# bağlantısı için write izni yeterlidir RHEL 9'da.
########################################

require {
    type httpd_t;
    type httpd_var_run_t;
    class sock_file { read write open };
}

allow httpd_t httpd_var_run_t:sock_file { read write open };
